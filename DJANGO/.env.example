# Azure Files Storage Configuration
# Copy this file to .env and fill in your Azure credentials

# Azure Storage Account Name (required)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Azure Storage Account Key (required if not using connection_string)
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key

# Azure Storage Connection String (optional, overrides account_name and account_key)
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=your_connection_string

# Azure File Share Name (default: filevault)
AZURE_STORAGE_SHARE_NAME=filevault

# IOPS Configuration
# Maximum IOPS per second for the entire application (default: 1000)
AZURE_STORAGE_IOPS_LIMIT=1000

# Time window for IOPS limiting in seconds (default: 1.0)
AZURE_STORAGE_IOPS_WINDOW=1.0

# Burst limit per IP address (default: 100)
AZURE_STORAGE_BURST_LIMIT=100

# Per-user IOPS limit (default: 100)
AZURE_STORAGE_USER_IOPS_LIMIT=100

# Per-company IOPS limit (default: 500)
AZURE_STORAGE_COMPANY_IOPS_LIMIT=500

# Django Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Cache Configuration (required for IOPS throttling in production)
# Use Redis for distributed cache in production
# REDIS_URL=redis://localhost:6379/1
